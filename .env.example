# --- LLM provider ---
# "anthropic" or "openai" (any OpenAI-compatible API via OPENAI_BASE_URL).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5

# Fill in only the key for the provider you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: point the "openai" provider at an OpenAI-compatible API (Groq, Gemini,
# OpenRouter, local Ollama, ...). Leave empty for OpenAI itself.
# Free tiers may use submitted data: send only non-sensitive sample topics.
OPENAI_BASE_URL=

# --- Guardrails ---
# Hard cap on LLM calls per hour; the run stops instead of silently burning spend.
MAX_LLM_CALLS_PER_HOUR=100
# Hard cap on rows drafted in one run.
MAX_ROWS_PER_RUN=10

# --- Backend ---
# "csv" (local file, no Google setup) or "sheet" (Google Sheet via service account).
BACKEND=csv
CSV_PATH=data/demo_topics.csv

# Only for BACKEND=sheet. Share the one review sheet with the service account's email.
SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# --- Audit ---
# Append-only JSONL log, one line per row outcome.
AUDIT_LOG_DIR=audit_logs
